---
pagination:
  data: locales
  size: 1
  alias: locale

eleventyComputed:
  permalink: "/{{ locale.code }}/privacy/index.html"

pageId: privacy
---

{% extends "layout.njk" %}

{% set t = i18n[locale.code] %}


{% block content %}

<div class="container legal">

  <h1>{{ t.privacy.title }}</h1>

  <p class="legal__updated">{{ t.privacy.updated }}</p>

  <p>{{ t.privacy.intro }}</p>


  <h2>{{ t.privacy.operatorTitle }}</h2>

  <p>{{ t.privacy.operator }}</p>


  <h2>{{ t.privacy.collectTitle }}</h2>

  <p>{{ t.privacy.collect }}</p>


  <h2>{{ t.privacy.clarityTitle }}</h2>

  <p>{{ t.privacy.clarity }}</p>

  <p>
    {{ t.privacy.clarityMore }}
    <a href="https://learn.microsoft.com/en-us/clarity/setup-and-installation/clarity-cookies" target="_blank" rel="noopener noreferrer">{{ t.privacy.clarityCookieLink }}</a>
    {{ t.privacy.and }}
    <a href="https://learn.microsoft.com/en-us/clarity/setup-and-installation/consent-mode" target="_blank" rel="noopener noreferrer">{{ t.privacy.clarityConsentLink }}</a>.
    {{ t.privacy.microsoftPolicyLead }}
    <a href="https://www.microsoft.com/privacy/privacystatement" target="_blank" rel="noopener noreferrer">{{ t.privacy.microsoftPolicyLink }}</a>.
  </p>


  <h2>{{ t.privacy.thirdPartiesTitle }}</h2>

  <p>{{ t.privacy.thirdParties }}</p>


  <h2>{{ t.privacy.useTitle }}</h2>

  <p>{{ t.privacy.use }}</p>


  <h2>{{ t.privacy.disclosureTitle }}</h2>

  <p>{{ t.privacy.disclosure }}</p>


  <h2>{{ t.privacy.retentionTitle }}</h2>

  <p>{{ t.privacy.retention }}</p>


  <h2>{{ t.privacy.rightsTitle }}</h2>

  <p>{{ t.privacy.rights }}</p>


  <h2>{{ t.privacy.contactTitle }}</h2>

  <p>{{ t.privacy.contact }}</p>

  <p>
    {{ t.privacy.businessContact }}, Shawarma Time &amp; Place ·
    <a href="mailto:info@shawarmatimeandplace.ca">info@shawarmatimeandplace.ca</a>.
  </p>

  <p>
    6 Byward Market Square, Ottawa, ON K1N 5M4 ·
    <a href="tel:+16132412882">+1 (613) 241-2882</a>.
  </p>

</div>

{% endblock %}
